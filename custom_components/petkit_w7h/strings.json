  "services": {
    "invoke": {
      "name": "Send raw action",
      "description": "Sends a raw service_invoke to the fountain (advanced).",
      "fields": {
        "service": {
          "name": "Service",
          "description": "e.g. start, stop, power, play_sound, privacy"
        },
        "payload": {
          "name": "Payload",
          "description": "e.g. {\"start_action\": 2}"
        }
      }
    },
    "set_settings": {
      "name": "Set raw settings",
      "description": "Sends raw settings (property_set) to the fountain (advanced).",
      "fields": {
        "settings": {
          "name": "Settings",
          "description": "e.g. {\"volume\": 5}"
        }
      }
    },
    "ignore_drink": {
      "name": "Ignore drink",
      "description": "Removes drinks from statistics and the drink card (e.g. false alarms).",
      "fields": {
        "event_id": {
          "name": "Event ID",
          "description": "ID of the drink event (attribute id), several allowed"
        },
        "ignore": {
          "name": "Ignore",
          "description": "Off = count the drink again"
        }
