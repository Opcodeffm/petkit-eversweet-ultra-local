{
  "config": {
    "step": {
      "user": {
        "title": "Set up Eversweet Ultra",
        "description": "Leave device ID and secret empty: Home Assistant then gives you a one-line command for the fountain that transfers both and switches the fountain over.",
        "data": {
          "public_host": "IP of this Home Assistant (as seen by the fountain)",
          "port": "Port",
          "device_id": "Device ID (dev_id, optional)",
          "device_secret": "Device secret (dev_srt, optional)"
        },
        "data_description": {
          "port": "The fountain talks to Home Assistant on this port (plain HTTP)."
        }
      }
    },
    "error": {
      "invalid_id": "Device ID must be a number",
      "id_and_secret": "Enter both device ID and secret, or leave both empty"
    },
    "abort": {
      "already_configured": "Already configured"
    },
    "create_entry": {
      "setup_command": "Almost done. Log in to the fountain once via telnet as root and run:\n\n`{command}`\n\nYou will also find this command in your notifications."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "description": "Pet recognition: put 3–6 photos of each pet's face (frontal, filling the frame) into Media › My media › petkit_w7h › pets › <name>. They are cropped to a square and handed to the fountain within 10 minutes.",
        "data": {
          "pet_name": "Pet name(s), comma-separated",
          "message_language": "Language of drink messages",
          "only_known": "Only count drinks recognized by face",
          "drink_merge_minutes": "Combine drinking breaks up to (minutes)",
          "clips": "Receive clips from the fountain",
          "retention_days": "Keep drink clips (days)",
          "retention_other_days": "Keep other clips (days)",
          "max_storage_gb": "Storage limit for all clips (GB)"
        },
        "data_description": {
          "only_known": "Off (recommended): every drink counts unless someone is handling the fountain (tray or tank out/in, button on the device). With a single pet, every drink is attributed to it. On: only drinks where the fountain recognized the face.",
          "drink_merge_minutes": "If the pet drinks, walks off briefly and drinks again, that counts as one drink. 0 = every sip on its own.",
          "retention_other_days": "Pet visits without drinking, removed drinks, flushing and water changes.",
          "max_storage_gb": "Above this, the oldest other clips are deleted first, then the oldest drink clips."
        }
      }
    }
  },
  "selector": {
    "message_language": {
      "options": {
        "de": "Deutsch",
        "en": "English"
      }
    }
  },
