{
  "config": {
    "step": {
      "user": {
        "title": "Eversweet Ultra einrichten",
        "description": "Geräte-ID und Secret leer lassen: Dann gibt dir Home Assistant einen Befehl für den Brunnen, der beides überträgt und den Brunnen umstellt.",
        "data": {
          "public_host": "IP dieser Home Assistant (aus Sicht des Brunnens)",
          "port": "Port",
          "device_id": "Geräte-ID (dev_id, optional)",
          "device_secret": "Geräte-Secret (dev_srt, optional)"
        },
        "data_description": {
          "port": "Über diesen Port spricht der Brunnen mit Home Assistant (einfaches HTTP)."
        }
      }
    },
    "error": {
      "invalid_id": "Die Geräte-ID muss eine Zahl sein",
      "id_and_secret": "Bitte Geräte-ID und Secret beide eintragen oder beide leer lassen"
    },
    "abort": {
      "already_configured": "Bereits eingerichtet"
    },
    "create_entry": {
      "setup_command": "Fast fertig. Melde dich einmal per Telnet als root am Brunnen an und führe aus:\n\n`{command}`\n\nDen Befehl findest du auch in deinen Benachrichtigungen."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Optionen",
        "description": "Tiererkennung: 3–6 Fotos vom Gesicht jedes Tiers (frontal, formatfüllend) nach Medien › Meine Medien › petkit_w7h › pets › <Name> hochladen. Sie werden quadratisch zugeschnitten und spätestens nach 10 Minuten an den Brunnen gegeben.",
        "data": {
          "pet_name": "Name(n) deiner Tiere, mit Komma getrennt",
          "message_language": "Sprache der Trink-Meldungen",
          "only_known": "Nur per Gesicht erkannte Trinkvorgänge zählen",
          "drink_merge_minutes": "Trinkpausen zusammenfassen bis (Minuten)",
          "clips": "Clips vom Brunnen empfangen",
          "retention_days": "Clips von Trinkvorgängen aufbewahren (Tage)",
          "retention_other_days": "Übrige Clips aufbewahren (Tage)",
          "max_storage_gb": "Höchstens so viel Speicher für alle Clips (GB)"
        },
        "data_description": {
          "only_known": "Aus (empfohlen): Jeder Trinkvorgang zählt, außer jemand hantiert gerade am Brunnen (Schale oder Tank raus/rein, Taste am Gerät). Bei nur einem Tier gehört ihm jeder Trinkvorgang. An: nur wenn der Brunnen das Gesicht erkannt hat.",
          "drink_merge_minutes": "Trinkt das Tier, geht kurz weg und trinkt weiter, zählt das als ein Trinkvorgang. 0 = jede Runde einzeln.",
          "retention_other_days": "Besuche ohne Trinken, aussortierte Trinkvorgänge, Spülen und Wasserwechsel.",
          "max_storage_gb": "Wird es mehr, gehen zuerst die ältesten übrigen Clips, dann die ältesten Trinkvorgänge."
        }
      }
    }
  },
